<?xml version="1.0" encoding="UTF-8"?>
<graph>
    <!-- Metadatos del modelo -->
    <metadata>
        <model_name>{model_name}</model_name>
        <max_nodes>{max_nodes}</max_nodes>
        <n_tokens>{n_tokens}</n_tokens>
        <n_embd_head>{n_embd_head}</n_embd_head>
        <n_layer>{n_layer}</n_layer>
        <model_type>{model_type}</model_type> <!-- Puede ser "LLAMA 2", "ViT" o "Whisper" -->
    </metadata>

    <!-- Capas del modelo -->
    <layers>
        <!-- Capa genérica (común a todos los modelos) -->
        <layer id="layer_1">
            <inputs>
                <tensor id="input_1" name="input_tensor" type="float32"/>
            </inputs>

            <operations>
                <!-- Atención multi-cabezal -->
                <operation id="op_1" type="multi_head_attention">
                    <inputs>
                        <input ref="input_1"/>
                    </inputs>
                    <outputs>
                        <output id="output_1" name="attention_output"/>
                    </outputs>
                    <parameters>
                        <parameter name="n_heads" value="8"/>
                        <parameter name="is_causal" value="true"/> <!-- Usar is_causal en lugar de use_causal_mask -->
                    </parameters>
                </operation>

                <!-- Feed-Forward -->
                <operation id="op_2" type="feed_forward">
                    <inputs>
                        <input ref="output_1"/>
                    </inputs>
                    <outputs>
                        <output id="output_2" name="ffn_output"/>
                    </outputs>
                    <parameters>
                        <parameter name="activation" value="gelu"/> <!-- Asegurar que el valor coincida con los nombres de las funciones -->
                    </parameters>
                </operation>

                <!-- Normalización -->
                <operation id="op_3" type="layer_norm">
                    <inputs>
                        <input ref="output_2"/>
                    </inputs>
                    <outputs>
                        <output id="output_3" name="norm_output"/>
                    </outputs>
                    <parameters>
                        <!-- Usar RMSNorm si el modelo es LLAMA 2, de lo contrario usar LayerNorm -->
                        <parameter name="use_rmsnorm" value="{model_type == 'LLAMA 2' ? 'true' : 'false'}"/>
                        <parameter name="eps" value="1e-5"/> <!-- Valor de épsilon -->
                    </parameters>
                </operation>
            </operations>

            <outputs>
                <tensor id="output_3" name="layer_output" type="float32"/>
            </outputs>
        </layer>

        <!-- Capa específica para ViT (Token de Clase) -->
        <layer id="layer_2">
            <condition>
                <if model_type="ViT">
                    <inputs>
                        <tensor id="input_2" name="patch_embeddings" type="float32"/>
                    </inputs>
                    <operations>
                        <operation id="op_4" type="class_token">
                            <inputs>
                                <input ref="input_2"/>
                            </inputs>
                            <outputs>
                                <output id="output_4" name="class_token_output"/>
                            </outputs>
                        </operation>
                    </operations>
                    <outputs>
                        <tensor id="output_4" name="class_token" type="float32"/>
                    </outputs>
                </if>
            </condition>
        </layer>

        <!-- Capa específica para Whisper (Cross-Attention) -->
        <layer id="layer_3">
            <condition>
                <if model_type="Whisper">
                    <inputs>
                        <tensor id="input_3" name="audio_embeddings" type="float32"/>
                        <tensor id="input_4" name="text_embeddings" type="float32"/>
                    </inputs>
                    <operations>
                        <operation id="op_5" type="cross_attention">
                            <inputs>
                                <input ref="input_3"/>
                                <input ref="input_4"/>
                            </inputs>
                            <outputs>
                                <output id="output_5" name="cross_attention_output"/>
                            </outputs>
                        </operation>
                    </operations>
                    <outputs>
                        <tensor id="output_5" name="cross_attention_output" type="float32"/>
                    </outputs>
                </if>
            </condition>
        </layer>

        <!-- Capa específica para LLAMA 2 (RMSNorm) -->
        <layer id="layer_4">
            <condition>
                <if model_type="LLAMA 2">
                    <inputs>
                        <tensor id="input_5" name="llama_input" type="float32"/>
                    </inputs>
                    <operations>
                        <operation id="op_6" type="layer_norm">
                            <inputs>
                                <input ref="input_5"/>
                            </inputs>
                            <outputs>
                                <output id="output_6" name="rmsnorm_output"/>
                            </outputs>
                            <parameters>
                                <parameter name="use_rmsnorm" value="true"/> <!-- Usar RMSNorm -->
                                <parameter name="eps" value="1e-5"/> <!-- Valor de épsilon -->
                            </parameters>
                        </operation>
                    </operations>
                    <outputs>
                        <tensor id="output_6" name="llama_output" type="float32"/>
                    </outputs>
                </if>
            </condition>
        </layer>
    </layers>

    <!-- Salida del modelo -->
    <output>
        <tensor id="final_output" name="model_output" type="float32"/>
    </output>
</graph>
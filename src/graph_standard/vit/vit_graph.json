{
    "metadata": {
      "model_name": "{model_name}",
      "hidden_size": "{hidden_size}",
      "num_hidden_layers": "{num_hidden_layers}",
      "num_attention_heads": "{num_attention_heads}",
      "num_classes": "{num_classes}",
      "input_shape": "{input_shape}"
    },
    "inputs": [
      {
        "name": "input",
        "type": "input",
        "shape": "{input_shape}"
      }
    ],
    "layers": [
      {
        "id": "preprocessing",
        "operations": [
          {
            "type": "{operation_type}",
            "inputs": [
              {
                "ref": "input"
              }
            ],
            "outputs": [
              {
                "name": "preprocessed_output"
              }
            ],
            "parameters": [
              {
                "name": "{parameter_name}",
                "ref": "{parameter_ref}"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "preprocessed_output",
            "type": "embedding"
          }
        ]
      },
      {
        "id": "{layer_id}",
        "inputs": [
          {
            "name": "input",
            "type": "embedding"
          }
        ],
        "operations": [
          {
            "type": "norm",
            "inputs": [
              {
                "ref": "input"
              }
            ],
            "outputs": [
              {
                "name": "norm_output"
              }
            ],
            "parameters": [
              {
                "name": "weights",
                "ref": "{norm_weights_ref}"
              },
              {
                "name": "bias",
                "ref": "{norm_bias_ref}"
              }
            ]
          },
          {
            "type": "self_attention",
            "inputs": [
              {
                "ref": "norm_output"
              }
            ],
            "outputs": [
              {
                "name": "attention_output"
              }
            ],
            "parameters": [
              {
                "name": "qkv_weights",
                "ref": "{qkv_weights_ref}"
              },
              {
                "name": "qkv_bias",
                "ref": "{qkv_bias_ref}"
              },
              {
                "name": "proj_weights",
                "ref": "{proj_weights_ref}"
              },
              {
                "name": "proj_bias",
                "ref": "{proj_bias_ref}"
              }
            ]
          },
          {
            "type": "add",
            "inputs": [
              {
                "ref": "attention_output"
              },
              {
                "ref": "input"
              }
            ],
            "outputs": [
              {
                "name": "skip_output"
              }
            ]
          },
          {
            "type": "feed_forward",
            "inputs": [
              {
                "ref": "skip_output"
              }
            ],
            "outputs": [
              {
                "name": "ffn_output"
              }
            ],
            "parameters": [
              {
                "name": "lin1_weights",
                "ref": "{lin1_weights_ref}"
              },
              {
                "name": "lin1_bias",
                "ref": "{lin1_bias_ref}"
              },
              {
                "name": "lin2_weights",
                "ref": "{lin2_weights_ref}"
              },
              {
                "name": "lin2_bias",
                "ref": "{lin2_bias_ref}"
              }
            ]
          },
          {
            "type": "add",
            "inputs": [
              {
                "ref": "ffn_output"
              },
              {
                "ref": "skip_output"
              }
            ],
            "outputs": [
              {
                "name": "layer_output"
              }
            ]
          }
        ],
        "outputs": [
          {
            "name": "layer_output",
            "type": "embedding"
          }
        ]
      }
    ],
    "output": {
      "operations": [
        {
          "type": "pooling",
          "inputs": [
            {
              "ref": "final_layer_output"
            }
          ],
          "outputs": [
            {
              "name": "pooled_output"
            }
          ]
        },
        {
          "type": "norm",
          "inputs": [
            {
              "ref": "pooled_output"
            }
          ],
          "outputs": [
            {
              "name": "norm_output"
            }
          ],
          "parameters": [
            {
              "name": "weights",
              "ref": "{norm_weights_ref}"
            },
            {
              "name": "bias",
              "ref": "{norm_bias_ref}"
            }
          ]
        },
        {
          "type": "linear",
          "inputs": [
            {
              "ref": "norm_output"
            }
          ],
          "outputs": [
            {
              "name": "logits"
            }
          ],
          "parameters": [
            {
              "name": "weights",
              "ref": "{head_weights_ref}"
            },
            {
              "name": "bias",
              "ref": "{head_bias_ref}"
            }
          ]
        },
        {
          "type": "softmax",
          "inputs": [
            {
              "ref": "logits"
            }
          ],
          "outputs": [
            {
              "name": "probs"
            }
          ]
        }
      ],
      "outputs": [
        {
          "name": "probs",
          "type": "output"
        }
      ]
    }
  }
  